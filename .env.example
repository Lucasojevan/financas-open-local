# Copie para .env e troque TODOS os valores marcados com change-me.
POSTGRES_DB=financas
POSTGRES_USER=financas
POSTGRES_PASSWORD=change-me-use-a-long-random-password
DATABASE_URL=postgresql://financas:change-me-use-a-long-random-password@postgres:5432/financas?schema=public

APP_ORIGIN=http://localhost:3000
PORT=3001
NODE_ENV=production
SESSION_COOKIE_NAME=financas_session
SESSION_TTL_HOURS=12

# 32 bytes em base64. Ex.: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=change-me-32-byte-base64-key

# Somente no backend. Preencha com as credenciais da aplicação criada na Pluggy.
OPEN_FINANCE_PROVIDER=pluggy
CLIENT_ID=
CLIENT_SECRET=
PLUGGY_SANDBOX=true
PLUGGY_WEBHOOK_SECRET=change-me-webhook-secret

# O frontend usa /api. O proxy server-side do Next alcança o backend internamente.
INTERNAL_API_URL=http://backend:3001
NEXT_PUBLIC_API_BASE_URL=/api
